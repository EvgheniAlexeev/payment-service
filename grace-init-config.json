{
  "projectType": "dotnet-multiservice",
  "annotationStyle": "xml-comments-inline",
  "contractSource": "source-files-only",
  "contractMarkers": {
    "module": "/// <summary>",
    "method": "/// <remarks>",
    "field": "/// <summary>"
  },
  "sourcePatterns": {
    "interfaces": "src/**/*Service.cs",
    "dtos": "src/**/*Dto.cs",
    "entities": "src/**/*Entity.cs",
    "aggregates": "src/**/*Aggregate.cs",
    "repositories": "src/**/*Repository.cs",
    "controllers": "src/**/*Controller.cs",
    "adapters": "src/**/*Adapter.cs"
  },
  "documentationFormat": {
    "module": {
      "tags": [
        "@contract (M-xxx)",
        "@purpose (one sentence, concrete verb)",
        "@module-type (ENTRY_POINT|CORE_LOGIC|DATA_LAYER|UTILITY|INTEGRATION)",
        "@depends (module list)",
        "@invariant (state constraints)",
        "@stability (STABLE|EVOLVING|EXPERIMENTAL)"
      ],
      "style": "xml-comments-block-at-namespace-level"
    },
    "class_interface": {
      "tags": [
        "@domain-concept (semantic term)",
        "@aggregate-root (YES|NO for DDD)",
        "@value-object (YES|NO)",
        "@invariant (object-level constraints)"
      ],
      "style": "xml-comments-above-class"
    },
    "method": {
      "tags": [
        "@contract-action (semantic action name)",
        "@param (parameter descriptions)",
        "@return (return value description)",
        "@throws (exception conditions)",
        "@log-event (observable markers)",
        "@trace-span (OpenTelemetry span names)",
        "@pre-condition (entry requirements)",
        "@post-condition (exit guarantees)",
        "@idempotent (YES|NO)",
        "@pure (YES|NO, side effects?)",
        "@complexity (O(1), O(log n), O(n), etc.)"
      ],
      "style": "xml-comments-above-method"
    },
    "field_property": {
      "tags": [
        "@invariant (field constraint)",
        "@valid-range (min-max, pattern)",
        "@unit (measurement unit if applicable)",
        "@required (YES|NO)"
      ],
      "style": "xml-comments-above-property"
    }
  },
  "extractionRules": {
    "contractIdPattern": "M-[A-Z][A-Z0-9]*-[A-Z]+",
    "readFrom": "source-files-only",
    "skipDirs": ["bin", "obj", "tests", ".vs", ".vscode"],
    "skipFiles": ["*.csproj.lscache", "*.AssemblyInfo.cs"],
    "parseEngines": ["dotnet-csharp-xml-comments"],
    "suppressExtractionFrom": "docs/doxygen-skeletons"
  },
  "modules": {
    "M-PAYMENT-READER": {
      "name": "PaymentService.Api.ReaderService",
      "sourceRoot": "src/PaymentService.Api.ReaderService",
      "type": "ENTRY_POINT",
      "depends": ["M-PAYMENT-PERSIST", "M-PAYMENT-SHARED"]
    },
    "M-PAYMENT-WRITER": {
      "name": "PaymentService.Api.WriterService",
      "sourceRoot": "src/PaymentService.Api.WriterService",
      "type": "ENTRY_POINT",
      "depends": ["M-PAYMENT-PERSIST", "M-PAYMENT-SHARED"]
    },
    "M-PAYMENT-PERSIST": {
      "name": "PaymentService.Persistence",
      "sourceRoot": "src/PaymentService.Persistence",
      "type": "DATA_LAYER",
      "depends": ["M-PAYMENT-SHARED"]
    },
    "M-PAYMENT-WORKER": {
      "name": "PaymentService.WorkerService",
      "sourceRoot": "src/PaymentService.WorkerService",
      "type": "CORE_LOGIC",
      "depends": ["M-PAYMENT-PERSIST", "M-PAYMENT-SHARED"]
    },
    "M-PAYMENT-SHARED": {
      "name": "PaymentService.Shared",
      "sourceRoot": "src/PaymentService.Shared",
      "type": "UTILITY",
      "depends": []
    }
  },
  "migrationState": {
    "skeletonsLocation": "docs/doxygen-skeletons",
    "migrationStrategy": "skeleton-to-source",
    "status": "pending-skeleton-migration"
  }
}
